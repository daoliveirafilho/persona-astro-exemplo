---
// Assets
import { Image } from "astro:assets";
import one from "@/images/projects/one.webp";
import two from "@/images/projects/two.webp";
import three from "@/images/projects/three.webp";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const featuredProjects = [
  {
    year: "2019",
    title: "Agentes de IA",
    description:
      "Acordo de processamento de dados, ferramentas de linguagem com contexto definido e alertas preditivos.",
    category: "Agentic AI",
    image: one,
    imageAlt:
      "A computer screen displaying a instalation list of packages with sizes.",
  },
  {
    year: "2017",
    title: "Rede CAN",
    description:
      "Capturar quadros de dados diferenciais (CAN High e CAN Low) sem interferir no barramento.",
    category: "Hardware Transceptor",
    image: three,
    imageAlt:
      "A dashboard with a digital display odometer showing 40801 km.",
  },
  {
    year: "2013",
    title: "Telemetria com M2M",
    description:
      "Infraestrutura baseada em cloud.",
    category: "M2M",
    image: two,
    imageAlt:
      "The back cover of the phone with a SIM card labeled 4G TIM.",
  },
];
---

<section class="scroll-mt-32" id="projects">
<Wrapper variant="standard" class="py-12 lg:py-24">
<div class="grid grid-cols-1 lg:grid-cols-4 items-start">
<div class="lg:col-start-2">
<Text tag="p" variant="textSM" class="text-base-600 dark:text-base-300"
Projeto(s) em destaque
</Text>
</div>
<Text
tag="h2"
variant="textXL"
class="font-semibold leading-snug text-left tracking-tighter lg:col-span-2 text-base-900 dark:text-white"
>Projects
<br />
</Text>
</div>

    <div class="flex flex-col gap-12 mt-8">
      {
        featuredProjects.map((project) => (
          <article class="py-12 border-t border-base-200 dark:border-base-800">
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 items-start">
              <Text
                tag="p"
                variant="textXS"
                class="text-base-600 dark:text-base-300 uppercase"
              >
                {project.year}
              </Text>
              <Text
                tag="h3"
                variant="displaySM"
                class="text-base-900 dark:text-white leading-tight font-semibold "
              >
                {project.title}
              </Text>
              <Text
                tag="p"
                variant="textSM"
                class="text-base-600 dark:text-base-300"
              >
                {project.description}
              </Text>
              <Text
                tag="p"
                variant="textXS"
                class="text-base-600 dark:text-base-300 uppercase lg:ml-auto lg:col-start-4"
              >
                {project.category}
              </Text>
            </div>
            <Image
              width={1200}
              height={630}
              src={project.image}
              alt={project.imageAlt}
              loading="lazy"
              decoding="async"
              class="size-full aspect-4/2 rounded-4xl mt-12 object-cover object-center"
            />
          </article>
        ))
      }
    </div>
  </Wrapper>
</section>
