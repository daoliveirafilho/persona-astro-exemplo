---
// Assets
import { Image } from "astro:assets";
import one from "@/images/work/one.webp";
import two from "@/images/work/two.webp";
import three from "@/images/work/three.webp";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const featuredProjects = [
  {
    year: "2021",
    title: "Tratamento automatizado dos dados",
    description:
      "Implemente a ISO 27001 em conformidade com a LGPD, mapeamento de ativos, treinamento da equipe e garantia em contrato.",
    category: "LGPD",
    image: one,
    imageAlt:
      "Dashboard using smart tools.",
  },
  {
    year: "2019",
    title: "UX/UI Design",
    description:
      "Responsividade com design simples e funcional.",
    category: "Visual Interface",
    image: two,
    imageAlt:
      "A technical UI mobile first.",
  },
  {
    year: "2016",
    title: "Software embarcado",
    description:
      "Plataforma simples com hardware modular, telemetria em tempo real e sistemas orientados a eventos.",
    category: "Hardware & Embedded Systems",
    image: three,
    imageAlt:
      "Microcontroller board.",
  },
];
---

<section class="scroll-mt-32" id="work">
<Wrapper variant="standard" class="py-12 lg:py-24">
<div class="grid grid-cols-1 lg:grid-cols-4 items-start">
<div class="lg:col-start-2">
<Text tag="p" variant="textSM" class="text-base-600 dark:text-base-300"
>>>>
</Text
>
</div>
<Text
tag="h2"
variant="textXL"
class="font-semibold leading-snug text-left tracking-tighter lg:col-span-2 text-base-900 dark:text-white"
>Trabalho(s) em destaque
<br />
</Text>
</div>

    <div class="flex flex-col lg:gap-12 mt-8">
      {
        featuredProjects.map((project) => (
          <article class="py-12 border-t border-base-200 dark:border-base-800">
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 items-start">
              <Text
                tag="p"
                variant="textXS"
                class="text-base-600 dark:text-base-300 uppercase"
              >
                {project.year}
              </Text>
              <Text
                tag="h3"
                variant="displaySM"
                class="text-base-900 dark:text-white leading-tight font-semibold "
              >
                {project.title}
              </Text>
              <Text
                tag="p"
                variant="textSM"
                class="text-base-600 dark:text-base-300"
              >
                {project.description}
              </Text>
              <Text
                tag="p"
                variant="textXS"
                class="text-base-600 dark:text-base-300 uppercase lg:ml-auto lg:col-start-4"
              >
                {project.category}
              </Text>
            </div>
            <Image
              width={1420}
              height={930}
              src={project.image}
              alt={project.imageAlt}
              loading="lazy"
              decoding="async"
              class="size-full aspect-4/2 rounded-4xl mt-12 object-cover object-center"
            />
          </article>
        ))
      }
    </div>
  </Wrapper>
</section>
