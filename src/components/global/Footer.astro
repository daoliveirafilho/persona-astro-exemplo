---
// Assets
import Logo from "@/components/assets/Logo.astro";
// Foundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const links = [
  { href: "https://github.com/daoliveirafilho", text: "GitHub" },
  { href: "https://medium.com/@da.oliveira.filho", text: "Medium" },
  { href: "https://openwebui.com/u/daoliveirafilho", text: "Open WebUI" },
  { href: "https://share.streamlit.io/user/daoliveirafilho", text: "Streamlit" },
  { href: "https://wasmer.io/daoliveirafilho", text: "Wasmer" },
];
---

<footer>
<Wrapper variant="standard" class="py-2">
<div class="grid grid-cols-2 lg:grid-cols-4 items-start">
<div
class="flex items-center gap-2 text-base-600 dark:text-base-300 text-xs tracking-tight"
>
/ {new Date().getFullYear()} Rekall
</div>
<div class="flex flex-wrap gap-8 text-sm items-center">
{
links.map((link) => (
<a
href={link.href}
class="text-base-600 tracking-tight  text-xs hover:text-base-900 dark:text-white transition-colors"
>
{link.text}
</a>
))
}
</div>
</div>
</Wrapper>
</footer>
